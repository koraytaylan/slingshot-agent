#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# Copyright 2026 Koray Taylan Davgana

# The gate. It takes no argument, fetches nothing, and writes nothing into the repository.
#
# What it needs prepared - the locked dependency cache and the pinned interoperability images - it
# verifies rather than acquires, refusing with the preparation command named when either is absent.
# A gate that quietly fetched a missing input would be a gate whose result depended on a remote
# server after all, which is the thing this whole arrangement exists to prevent.
#
# The stage list below is checked against policy/quality-gate.toml in both directions, so a stage
# that runs and is not declared, or is declared and does not run, fails.

set -o errexit
set -o nounset
set -o pipefail

readonly REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly CACHE_DIRECTORY="${REPOSITORY_ROOT}/.dependency-cache"
readonly GATE_POLICY="${REPOSITORY_ROOT}/policy/quality-gate.toml"
readonly EXIT_USAGE=2

if [[ $# -ne 0 ]]; then
    printf 'quality takes no argument, and was given: %s\n' "$*" >&2
    printf 'It runs every stage every time, because a gate with a way to run less of it is a gate\n' >&2
    printf 'whose result depends on how somebody invoked it.\n' >&2
    exit "${EXIT_USAGE}"
fi

# Offline, out of the verified cache, for every stage that reaches the build.
build() {
    "${REPOSITORY_ROOT}/mvnw" --offline --batch-mode --no-transfer-progress \
        -Dmaven.repo.local="${CACHE_DIRECTORY}" \
        -f "${REPOSITORY_ROOT}/pom.xml" \
        "$@"
}

stage() {
    printf '\n== %s\n' "$1"
    shift
    "$@"
}

stage locked-dependency-cache "${REPOSITORY_ROOT}/scripts/verify_locked_dependency_cache"
stage pinned-interop-images "${REPOSITORY_ROOT}/scripts/verify_interop_images"
stage formatting build checkstyle:check -pl core,aem,development,interop
stage compilation build compile -pl core,aem,development,interop
stage static-analysis build compile pmd:check spotbugs:check -pl core,aem,development,interop
# Every check below decides from this one pass rather than starting a build of its own.
#
# The gate runs every stage every time, and it did: thirty-six times, each one a fresh Maven, a
# fresh reactor scan and a fresh JVM to run a single test class that the run before it had already
# compiled. That is not thirty-six checks, it is one suite and thirty-five restarts - it was over a
# fifth of the gate's hour, and none of it decided anything the first pass had not.
#
# So the suite runs once and each stage is held to its own result. A stage that fails still fails by
# name, out of the report the runner wrote for that class, and a stage whose class produced no
# report at all fails too - because a check that did not run is not a check that passed.
run_the_policy_suite() {
    # Cleared first, so a report that is there afterwards is one this run wrote. Reading a report
    # left by an earlier run is how a stage reports a pass for a check that never ran.
    rm -rf "${REPOSITORY_ROOT}/development/target/surefire-reports"
    build test -Dtest=SourcePolicyTest,NullabilityPolicyTest,ApiShapePolicyTest,MethodShapePolicyTest,JavadocPolicyTest,AllocationPolicyTest,AdobePracticePolicyTest,DependencyPolicyTest,ImportedPackagesTest,ModuleDirectionTest,StatusMappingCoverageTest,ScenarioInventoryTest,CommandConformanceTest,MutationCoverageTest,ControlCapabilityCoverageTest,RegistryCompletenessTest,CommandReferenceTest,PlatformCoverageTest,OverlayAuditTest,FuzzTargetInventoryTest,ParserFuzzTest,TokenStreamFuzzTest,CommandArgumentFuzzTest,StateMachinePropertyTest,AcceptanceMatrixTest,PresentStateTest,WorkflowPolicyTest,InteropWorkflowTest,ReleaseWorkflowTest,ReleaseArtifactsTest,BillOfMaterialsTest,PublicationAuthorityTest,CentralPrerequisitesTest,AdvisoryGateTest,WireCompatibilityTest,PlatformFloorTest,EscalationSurfaceTest,InjectionAuditTest,ExposureSurfaceTest,ClockUsagePolicyTest,ConsoleSurfaceTest,ConsoleAccessibilityTest,LogStatementPolicyTest,FrontEndFootprintTest \
        -pl development -am -Dsurefire.failIfNoSpecifiedTests=false > "${POLICY_SUITE_OUTPUT}" 2>&1 \
        || true
}

decided() {
    local passed=0
    for class in "$@"; do
        local report
        report="$(find "${REPOSITORY_ROOT}/development/target/surefire-reports" \
            -name "TEST-*.${class}.xml" -print -quit 2>/dev/null)"
        if [[ -z "${report}" ]]; then
            printf '%s produced no result at all; the suite output is in %s\n' \
                "${class}" "${POLICY_SUITE_OUTPUT}" >&2
            passed=1
            continue
        fi
        if ! grep -q 'failures="0"' "${report}" || ! grep -q 'errors="0"' "${report}"; then
            printf '%s refused this change; its report is %s\n' "${class}" "${report}" >&2
            passed=1
        fi
    done
    return "${passed}"
}

readonly POLICY_SUITE_OUTPUT="${REPOSITORY_ROOT}/development/target/policy-suite.log"

run_the_policy_suite

stage source-policy decided SourcePolicyTest
stage nullability decided NullabilityPolicyTest
stage api-shape decided ApiShapePolicyTest
stage method-shape decided MethodShapePolicyTest
stage documentation decided JavadocPolicyTest
stage allocation decided AllocationPolicyTest
stage adobe-practice decided AdobePracticePolicyTest
stage tests-and-coverage-floor build verify
stage package-analysis build verify -pl all -am -DskipTests -Djacoco.skip=true
stage dependency-policy decided DependencyPolicyTest
stage imported-package-footprint decided ImportedPackagesTest
stage module-direction decided ModuleDirectionTest
stage status-mapping-coverage decided StatusMappingCoverageTest
stage interop-coverage decided ScenarioInventoryTest
stage command-conformance decided CommandConformanceTest
stage mutation-coverage decided MutationCoverageTest
stage control-capability decided ControlCapabilityCoverageTest
stage registry-completeness decided RegistryCompletenessTest
stage command-reference decided CommandReferenceTest
stage platform-coverage decided PlatformCoverageTest
stage overlay-audit decided OverlayAuditTest
stage fuzz-target-inventory decided FuzzTargetInventoryTest
stage parser-and-token-fuzzing decided ParserFuzzTest TokenStreamFuzzTest CommandArgumentFuzzTest
stage state-machine-properties decided StateMachinePropertyTest
stage acceptance-and-present-state decided AcceptanceMatrixTest PresentStateTest
stage workflow-policy decided WorkflowPolicyTest InteropWorkflowTest ReleaseWorkflowTest
stage release-contract decided ReleaseArtifactsTest BillOfMaterialsTest PublicationAuthorityTest CentralPrerequisitesTest
stage advisory-gate decided AdvisoryGateTest
stage wire-compatibility decided WireCompatibilityTest
stage platform-floor decided PlatformFloorTest
stage escalation-surface decided EscalationSurfaceTest
stage injection-audit decided InjectionAuditTest
stage exposure-surface decided ExposureSurfaceTest
stage clock-usage-policy decided ClockUsagePolicyTest
stage console-surface decided ConsoleSurfaceTest
stage console-accessibility decided ConsoleAccessibilityTest
stage log-statement-policy decided LogStatementPolicyTest
stage front-end-footprint decided FrontEndFootprintTest
stage public-interop-tier build verify -pl interop -am -DskipTests -Djacoco.skip=true

printf '\n== gate passed\n'
printf 'A passing gate is not a complete one. These tiers did not run here:\n'
python3 - "${GATE_POLICY}" <<'PYTHON'
import pathlib
import sys

name = title = command = ""
runs_here = True
for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
    stripped = line.strip()
    if stripped.startswith("name = "):
        name = stripped.split('"')[1]
    elif stripped.startswith("title = "):
        title = stripped.split('"')[1]
    elif stripped.startswith("run_by_the_gate = "):
        runs_here = stripped.endswith("true")
    elif stripped.startswith("command = ") and not runs_here:
        command = stripped.split('"')[1]
        print("  tier %s, the %s tier: %s" % (name, title, command))
        runs_here = True
PYTHON
