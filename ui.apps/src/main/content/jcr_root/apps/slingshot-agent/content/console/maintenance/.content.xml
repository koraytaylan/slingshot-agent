<!--
  Generation, capacity and the last sweep. Every number here is one somebody only wants once and
  always urgently, none of it is visible from the content, none of it is in a log, and an operator
  who does not know it exists has no way to ask - which is the whole reason this page is where they
  are already looking rather than in a document they would have to be told about.
-->
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="slingshot.agent.console.maintenance.title"
          sling:resourceType="granite/ui/components/shell/page">
    <head jcr:primaryType="nt:unstructured">
        <clientlibs jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/includeclientlibs"
                    categories="[slingshot.agent.console]"/>
    </head>
    <title jcr:primaryType="nt:unstructured"
           sling:resourceType="granite/ui/components/coral/foundation/text"
           text="slingshot.agent.console.maintenance.title"/>
    <content jcr:primaryType="nt:unstructured"
             sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <readings jcr:primaryType="nt:unstructured"
                      sling:resourceType="granite/ui/components/coral/foundation/table"
                      granite:id="slingshot-agent-maintenance"
                      jcr:title="slingshot.agent.console.maintenance.title"
                      granite:label="slingshot.agent.console.maintenance.title"
                      emptyText="slingshot.agent.console.maintenance.empty"
                      selectionMode="none">
                <datasource jcr:primaryType="nt:unstructured"
                            sling:resourceType="slingshot-agent/datasource/maintenance"/>
                <columns jcr:primaryType="nt:unstructured">
                    <name jcr:primaryType="nt:unstructured"
                          jcr:title="slingshot.agent.console.column.reading"/>
                    <value jcr:primaryType="nt:unstructured"
                           jcr:title="slingshot.agent.console.column.value"/>
                </columns>
            </readings>
        </items>
    </content>
</jcr:root>
