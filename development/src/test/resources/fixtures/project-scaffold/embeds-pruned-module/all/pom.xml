<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>rs.slingshot</groupId>
    <artifactId>slingshot-agent-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>slingshot-agent-all</artifactId>
  <packaging>content-package</packaging>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.jackrabbit</groupId>
        <artifactId>filevault-package-maven-plugin</artifactId>
        <configuration>
          <embeddeds>
            <embedded>
              <groupId>rs.slingshot</groupId>
              <artifactId>slingshot-agent-ui.content</artifactId>
              <target>/apps/slingshot-agent-packages/content/install</target>
            </embedded>
          </embeddeds>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
